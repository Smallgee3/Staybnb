@model CheckInProcessInputModel
@{ ViewData["Title"] = "Configure check-in"; }

<div class="row justify-content-center"><div class="col-lg-8"><h1>Configure guest check-in</h1><p class="text-muted">These instructions are shown to approved guests before they upload their document.</p><form asp-action="CheckInProcess" method="post" class="card card-body"><input asp-for="PropertyId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="RequiredDocuments" class="form-label"></label><input asp-for="RequiredDocuments" class="form-control" placeholder="ID or Passport" /><span asp-validation-for="RequiredDocuments" class="text-danger"></span></div><div class="mb-3"><label asp-for="Instructions" class="form-label"></label><textarea asp-for="Instructions" class="form-control" rows="6" placeholder="Arrival time, access procedure, document criteria, and house rules."></textarea><span asp-validation-for="Instructions" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label">Require this process for approved bookings</label></div><button class="btn btn-danger" type="submit">Save check-in process</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
