@model List<Booking>
@{ ViewData["Title"] = "Host bookings"; }

<div class="d-flex justify-content-between align-items-center mb-3"><h1>All booking requests</h1><a asp-action="Dashboard" class="btn btn-outline-secondary">Back to dashboard</a></div>
@if (!Model.Any()) { <div class="empty-state">No bookings have been requested for your listings.</div> }
else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Guest</th><th>Property</th><th>Stay</th><th>Travelers</th><th>Total</th><th>Status</th><th>Document</th><th>Action</th></tr></thead><tbody>@foreach (var booking in Model) { var document = booking.GuestDocuments.OrderByDescending(d => d.UploadedAt).FirstOrDefault(); <tr><td>@booking.Guest.FirstName @booking.Guest.LastName<br /><small>@booking.Guest.Email</small></td><td>@booking.Property.Title</td><td>@booking.CheckInDate.ToString("dd MMM yyyy") – @booking.CheckOutDate.ToString("dd MMM yyyy")</td><td>@booking.TravelerCount</td><td>@booking.TotalPrice.ToString("C")</td><td><span class="badge text-bg-secondary">@booking.Status</span></td><td>@if (document is not null) { <a href="@document.DocumentUrl" target="_blank">@document.Status</a> } else { <span class="text-muted">Not uploaded</span> }</td><td>@if (booking.Status == BookingStatus.Pending) { <form asp-action="UpdateBookingStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><button class="btn btn-sm btn-success" name="approve" value="true">Approve</button><button class="btn btn-sm btn-outline-danger" name="approve" value="false">Reject</button></form> }</td></tr> }</tbody></table></div> }
