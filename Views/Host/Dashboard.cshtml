@model HostDashboardViewModel
@{ ViewData["Title"] = "Host dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Host dashboard</h1><p class="text-muted mb-0">Manage your properties, requests, and check-ins.</p></div><a class="btn btn-outline-danger" asp-action="Bookings">All bookings</a></div>
<h2 class="h4">My listings</h2>
@if (!Model.Properties.Any()) { <div class="empty-state">Your approved listing will appear here.</div> }
else { <div class="row g-3 mb-5">@foreach (var property in Model.Properties) { <div class="col-md-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><h3 class="h5">@property.Title</h3><span class="badge text-bg-@(property.IsActive ? "success" : "secondary")">@(property.IsActive ? "Active" : "Inactive")</span></div><p class="text-muted">@property.City · @property.PricePerNight.ToString("C") / night</p><a asp-action="CheckInProcess" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-secondary">Configure check-in</a><form class="d-inline" asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@property.Id" /><button class="btn btn-sm btn-outline-danger">@(property.IsActive ? "Deactivate" : "Activate")</button></form></div></div></div> }</div> }
<h2 class="h4">Pending booking requests</h2>
@if (!Model.PendingBookings.Any()) { <p class="text-muted">No booking requests require a decision.</p> }
else { <div class="table-responsive mb-5"><table class="table"><thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Action</th></tr></thead><tbody>@foreach (var booking in Model.PendingBookings) { <tr><td>@booking.Guest.FirstName @booking.Guest.LastName</td><td>@booking.Property.Title</td><td>@booking.CheckInDate.ToString("dd MMM") – @booking.CheckOutDate.ToString("dd MMM yyyy")</td><td>@booking.TotalPrice.ToString("C")</td><td><form class="d-inline" asp-action="UpdateBookingStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><button class="btn btn-sm btn-success" name="approve" value="true">Approve</button><button class="btn btn-sm btn-outline-danger" name="approve" value="false">Reject</button></form></td></tr> }</tbody></table></div> }
<h2 class="h4">Documents awaiting verification</h2>
@if (!Model.PendingDocuments.Any()) { <p class="text-muted">No guest documents need review.</p> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>Guest</th><th>Property</th><th>Document</th><th>Decision</th></tr></thead><tbody>@foreach (var document in Model.PendingDocuments) { <tr><td>@document.Booking.Guest.FirstName @document.Booking.Guest.LastName</td><td>@document.Booking.Property.Title</td><td><a href="@document.DocumentUrl" target="_blank" rel="noopener">View @document.DocumentType</a></td><td><form class="d-inline" asp-action="VerifyDocument" method="post"><input type="hidden" name="id" value="@document.Id" /><button class="btn btn-sm btn-success" name="approve" value="true">Verify / check in</button><button class="btn btn-sm btn-outline-danger" name="approve" value="false">Reject</button></form></td></tr> }</tbody></table></div> }
