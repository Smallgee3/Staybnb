@model ComposeMessageInputModel
@{ ViewData["Title"] = "Compose message"; var users = (List<ApplicationUser>)ViewBag.Users; }

<div class="row justify-content-center"><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center mb-3"><h1>Compose message</h1><a asp-action="Index" class="btn btn-outline-secondary">Back to inbox</a></div><form asp-action="Compose" method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="RecipientId" class="form-label">Recipient</label><select asp-for="RecipientId" class="form-select"><option value="">Select a user</option>@foreach (var user in users) { <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option> }</select><span asp-validation-for="RecipientId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="mb-3"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" rows="8" class="form-control"></textarea><span asp-validation-for="Body" class="text-danger"></span></div><button class="btn btn-danger" type="submit">Send message</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
