@model List<HostApplication>
@{ ViewData["Title"] = "Host application review"; }

<div class="d-flex justify-content-between align-items-center mb-3"><h1>Host applications</h1><a class="btn btn-outline-secondary" asp-action="Dashboard">Back to admin centre</a></div>
@if (!Model.Any()) { <div class="empty-state">No host applications have been submitted.</div> }
else { <div class="accordion" id="applicationAccordion">@foreach (var application in Model) { var collapseId = "application" + application.Id; var badge = application.Status == HostApplicationStatus.Approved ? "success" : application.Status == HostApplicationStatus.Rejected ? "danger" : "warning"; <div class="accordion-item"><h2 class="accordion-header" id="heading-@application.Id"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId"><span class="me-3">@application.Title</span><span class="badge text-bg-@badge">@application.Status</span><span class="ms-auto me-3 small text-muted">@application.Applicant.FirstName @application.Applicant.LastName · @application.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></button></h2><div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#applicationAccordion"><div class="accordion-body"><div class="row"><div class="col-lg-7"><p class="preserve-lines">@application.Description</p><dl class="row"><dt class="col-sm-4">Applicant</dt><dd class="col-sm-8">@application.Applicant.Email</dd><dt class="col-sm-4">Property</dt><dd class="col-sm-8">@application.PropertyType · @application.Address, @application.City</dd><dt class="col-sm-4">Fees</dt><dd class="col-sm-8">@application.PricePerNight.ToString("C") per night, @application.CleaningFee.ToString("C") cleaning, @application.ServiceFee.ToString("C") service</dd></dl></div><div class="col-lg-5"><div class="row g-2">@foreach (var image in application.PropertyImages) { <div class="col-6"><img src="@image.ImageUrl" class="gallery-thumb" alt="Submitted property" /></div> }</div></div></div>@if (application.Status == HostApplicationStatus.Pending) { <form asp-action="ReviewApplication" method="post" class="border-top mt-3 pt-3"><input type="hidden" name="Id" value="@application.Id" /><label class="form-label" for="comment-@application.Id">Review comment (optional)</label><textarea id="comment-@application.Id" name="AdminComment" class="form-control mb-2" rows="2"></textarea><button class="btn btn-success" name="Approve" value="true">Approve and change Guest to Host</button><button class="btn btn-outline-danger" name="Approve" value="false">Reject</button></form> } else if (!string.IsNullOrWhiteSpace(application.AdminComment)) { <p class="mt-3 mb-0"><strong>Review comment:</strong> @application.AdminComment</p> }</div></div></div> }</div> }
