@model PropertySearchViewModel
@{
    ViewData["Title"] = "Find a place to stay";
}

<section class="hero mb-4">
    <div class="hero-content">
        <p class="text-uppercase fw-semibold mb-1">Staybnb</p>
        <h1>Find your next place to stay.</h1>
        <p>Discover homes managed by local hosts and book with confidence.</p>
    </div>
</section>

<form method="get" class="search-bar card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label" for="city">City</label><input class="form-control" id="city" name="city" value="@Model.City" placeholder="e.g. Cape Town" /></div>
        <div class="col-md-5"><label class="form-label" for="propertyType">Property type</label><input class="form-control" id="propertyType" name="propertyType" value="@Model.PropertyType" placeholder="e.g. Apartment" /></div>
        <div class="col-md-2"><button class="btn btn-danger w-100" type="submit">Search</button></div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h3 mb-0">Active stays</h2><span class="text-muted">@Model.Properties.Count result(s)</span></div>
@if (!Model.Properties.Any())
{
    <div class="empty-state">No active listings match your search. Please try different filters.</div>
}
else
{
    <div class="row g-4">
    @foreach (var property in Model.Properties)
    {
        var image = property.PropertyImages.OrderBy(i => i.SortOrder).FirstOrDefault()?.ImageUrl ?? "https://placehold.co/800x520?text=Staybnb";
        var averageRating = property.Reviews.Any() ? property.Reviews.Average(r => r.Rating).ToString("0.0") : "New";
        <div class="col-md-6 col-lg-4">
            <article class="property-card h-100">
                <img src="@image" alt="@property.Title" class="property-card-image" />
                <div class="p-3">
                    <div class="d-flex justify-content-between"><span class="fw-semibold">@property.City · @property.PropertyType</span><span>★ @averageRating</span></div>
                    <h3 class="h5 mt-2">@property.Title</h3>
                    <p class="mb-3"><strong>@property.PricePerNight.ToString("C")</strong> night</p>
                    <a class="stretched-link" asp-action="Details" asp-route-id="@property.Id">View listing</a>
                </div>
            </article>
        </div>
    }
    </div>
}
